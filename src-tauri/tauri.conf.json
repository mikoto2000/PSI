{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PNG Structure Inspector",
  "version": "1.0.0",
  "identifier": "app.png-structure-inspector.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PNG Structure Inspector",
        "width": 1280,
        "height": 840,
        "minWidth": 420,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"
    ]
  }
}
